# ===== 正式部署環境變數範本 =====
# 用法：在伺服器上 cp .env.prod .env 後填入機密，再 docker compose -f docker-compose.prod.yml up -d
# .env 已被 .gitignore 排除，切勿把填好金鑰的 .env 提交。

# ---- 環境：testnet(安全) / mainnet(真錢) ----
BINANCE_ENV=testnet
TRADING_DRY_RUN=true

# ---- testnet 金鑰（BINANCE_ENV=testnet 時用）----
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_REST=https://testnet.binance.vision
BINANCE_FUTURES_REST=https://testnet.binancefuture.com

# ---- mainnet 金鑰（BINANCE_ENV=mainnet 時用；IP 白名單填本 VM 的對外 IP）----
BINANCE_MAINNET_API_KEY=
BINANCE_MAINNET_API_SECRET=
BINANCE_MAINNET_REST=https://api.binance.com

# ---- 合約 USDT-M 金鑰（與現貨不同組；testnet 在 testnet.binancefuture.com 申請）----
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=
BINANCE_MAINNET_FUTURES_API_KEY=
BINANCE_MAINNET_FUTURES_API_SECRET=

# ---- 即時成交回報 User Data Stream ----
# 現貨：新版 WS API，需「Ed25519」類型 API 金鑰（HMAC 金鑰不能 logon）。
#   1) 本機 openssl genpkey -algorithm ed25519 -out secrets/ed25519.pem
#      openssl pkey -in secrets/ed25519.pem -pubout  → 公鑰貼到幣安 API 管理「Ed25519」建立金鑰
#   2) BINANCE_ED25519_API_KEY 填幣安給的 key；KEY_PATH 填容器內路徑 /run/secrets/ed25519.pem
#   開了卻缺任一項 → order-execution-service 拒絕啟動（不會靜默吞掉成交回報）
#   Dry-Run 時先不連線；在連線設定關 Dry-Run / 上膛後自動啟動。正式網要用 binance.com 的 Ed25519 金鑰
BINANCE_UDS_ENABLED=false
BINANCE_ED25519_API_KEY=
BINANCE_ED25519_KEY_PATH=/run/secrets/ed25519.pem
# 合約：listenKey 版，用上面的合約 HMAC 金鑰即可
BINANCE_FUTURES_UDS_ENABLED=false
# 兩者都關時：成交靠下單回應(RESULT)解析，掛單後才成交的部分由對帳排程補記。

# ---- 行情估值來源（正式網公開端點，免金鑰）----
MARKET_REST=https://api.binance.com

# ---- Slack 通知 ----
SLACK_WEBHOOK_URL=

# ---- JWT（true=強制登入驗證）----
# 預設 true（強制登入）。只有本機開發才可設 false；gateway 會在 log 大聲警告。
JWT_ENABLED=true
# 必填。產生：openssl rand -base64 48 。範本字串 / 太短會拒絕啟動。
JWT_SECRET=
# 初始管理員（只在 users 表為空時建立一次）。ADMIN_PASSWORD 留空 → 隨機密碼印在 auth-service 啟動 log。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- 前端對外埠（你的反向代理指到這個埠）----
FRONTEND_PORT=8088

# ---- Grafana ----
GRAFANA_USER=admin
GRAFANA_PASS=請改成強密碼
