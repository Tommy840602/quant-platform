<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.quant.keepalive</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/huangyanwei/trade/quant-platform/backend/keepalive.sh</string>
    </array>

    <!-- 登入時就跑一次 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 每 300 秒（5 分鐘）檢查一次，掛掉自動補起 -->
    <key>StartInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>/Users/huangyanwei/trade/quant-platform/backend/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/huangyanwei/trade/quant-platform/backend/logs/launchd.err.log</string>
</dict>
</plist>
