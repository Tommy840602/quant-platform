# ===== 量化交易平台環境變數 =====
# 由 start-all.sh 自動載入並注入各服務。修改後重新 ./start-all.sh 生效。
# 本檔含機密，已列入 .gitignore，請勿提交。

# ---- 幣安 API（現貨/合約 testnet）----
# 於 https://testnet.binance.vision 申請後填入
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_REST=https://testnet.binance.vision
BINANCE_WS=wss://stream.testnet.binance.vision

# ---- 交易開關 ----
# true=乾跑不送單（預設，安全）；填好上面金鑰後改 false 才會真的送 testnet
TRADING_DRY_RUN=true

# ---- JWT 認證 ----
# false=gateway 放行（開發）；true=強制驗證，前端需先登入 admin/admin
JWT_ENABLED=false
# auth 與 gateway 必須一致；正式請改成夠長的隨機字串（>=32 bytes）
JWT_SECRET=change-me-in-prod-please-use-a-long-random-secret-key

# ---- 基礎設施位址（本機預設即可）----
NACOS_ADDR=localhost:8848
NACOS_USER=nacos
NACOS_PASS=nacos
KAFKA_ADDR=localhost:9092
REDIS_HOST=localhost
DB_HOST=localhost
DB_PORT=5433

# ---- 新版 WebSocket API User Data Stream（即時成交回報，需 Ed25519 金鑰）----
# true 啟用；啟用後成交回報改由幣安 executionReport 驅動（OrderService 不再從下單回應自發）
BINANCE_UDS_ENABLED=false
# 於 testnet 另外生成一把「Ed25519」API Key（與現貨 HMAC 那把不同）
BINANCE_ED25519_API_KEY=
# 私鑰 PEM 檔路徑（相對 backend/ 目錄），內容為 -----BEGIN PRIVATE KEY----- 那份
BINANCE_ED25519_KEY_PATH=./ed25519-testnet.pem
BINANCE_WS_API=wss://ws-api.testnet.binance.vision/ws-api/v3

# ---- USDT-M 合約 testnet（金鑰與現貨不同，於 testnet.binancefuture.com 申請）----
BINANCE_FUTURES_REST=https://testnet.binancefuture.com
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=

# ---- Slack 通知（Incoming Webhook URL）----
SLACK_WEBHOOK_URL=
