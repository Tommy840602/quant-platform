{
 "title": "Quant Platform — 服務總覽",
 "uid": "quant-overview",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "15s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "DS",
    "type": "datasource",
    "query": "prometheus",
    "current": {
     "text": "Prometheus",
     "value": "Prometheus"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "服務存活（up）",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "up",
     "legendFormat": "{{service}}"
    }
   ],
   "fieldConfig": {
    "defaults": {}
   },
   "options": {}
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "JVM Heap 使用",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service) (jvm_memory_used_bytes{area=\"heap\"})",
     "legendFormat": "{{service}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    }
   },
   "options": {}
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "HTTP 請求率 (req/s)",
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service) (rate(http_server_requests_seconds_count[1m]))",
     "legendFormat": "{{service}}"
    }
   ],
   "fieldConfig": {
    "defaults": {}
   },
   "options": {}
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "HTTP p95 延遲",
   "gridPos": {
    "x": 12,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_server_requests_seconds_bucket[5m])))",
     "legendFormat": "{{service}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    }
   },
   "options": {}
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "HTTP 5xx 率",
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service) (rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))",
     "legendFormat": "{{service}}"
    }
   ],
   "fieldConfig": {
    "defaults": {}
   },
   "options": {}
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Kafka 消費速率 (msg/s)",
   "gridPos": {
    "x": 12,
    "y": 14,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service) (rate(spring_kafka_listener_seconds_count[1m]))",
     "legendFormat": "{{service}}"
    }
   ],
   "fieldConfig": {
    "defaults": {}
   },
   "options": {}
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "GC 暫停時間 (s/s)",
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service) (rate(jvm_gc_pause_seconds_sum[5m]))",
     "legendFormat": "{{service}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    }
   },
   "options": {}
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "執行緒數",
   "gridPos": {
    "x": 12,
    "y": 22,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service) (jvm_threads_live_threads)",
     "legendFormat": "{{service}}"
    }
   ],
   "fieldConfig": {
    "defaults": {}
   },
   "options": {}
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "DB 連線池使用",
   "gridPos": {
    "x": 0,
    "y": 30,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service) (hikaricp_connections_active)",
     "legendFormat": "{{service}} active"
    },
    {
     "refId": "B",
     "expr": "sum by (service) (hikaricp_connections_max)",
     "legendFormat": "{{service}} max"
    }
   ],
   "fieldConfig": {
    "defaults": {}
   },
   "options": {}
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Redis / Feign 錯誤",
   "gridPos": {
    "x": 12,
    "y": 30,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service) (rate(lettuce_command_completion_seconds_count{status!=\"success\"}[5m]))",
     "legendFormat": "{{service}} redis"
    },
    {
     "refId": "B",
     "expr": "sum by (service) (rate(http_client_requests_seconds_count{status=~\"5..|4..\"}[5m]))",
     "legendFormat": "{{service}} feign"
    }
   ],
   "fieldConfig": {
    "defaults": {}
   },
   "options": {}
  }
 ],
 "tags": [
  "quant"
 ]
}